# ═══════════════════════════════════════════════════════════════════
#  Analyst Studio — Yapılandırma
#  Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ── AI Erişimi (BİRİNİ seçin) ──────────────────────────────────────

# Seçenek A (ÖNERİLEN): Claude CLI — abonelik kapsamında, ücretsiz.
# Önce kurun:  npm install -g @anthropic-ai/claude-code  →  sonra: claude (giriş)
USE_CLAUDE_CLI=true
# CLI modunda kullanılacak model. Boş bırakılırsa Claude Code KENDİ varsayılanını
# seçer (bu bir premium/pahalı model — ör. 'fable' — olabilir → istenmeyen ücretli
# kullanım). Bu yüzden açıkça belirtilir. Alias: sonnet | opus | haiku (ya da tam ad).
CLAUDE_CLI_MODEL=sonnet

# Seçenek B: Doğrudan Anthropic API — token bazlı ücret.
# Yukarıdaki satırı silin/false yapın ve aşağıyı doldurun:
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Token / Hız Ayarları (opsiyonel) ───────────────────────────────
# HIZLI_MOD=true          # Teknik analizin AI denetçi aşamasını atlar.
#                         # Denetçi, teknik+süreç metnini İKİNCİ kez modele
#                         # gönderen en pahalı ikinci çağrıdır — 429 limitine
#                         # takılıyorsanız açın. Deterministik kapsam denetimi
#                         # (ID izlenebilirlik) her durumda çalışır.
# EXTENDED_THINKING=true  # Daha derin akıl yürütme (daha yavaş + daha çok token)
# API_CACHE=false         # Çıktı önbelleğini kapat (varsayılan açık — aynı
#                         # girdiyle tekrar çalıştırma 0 token harcar)

# ── Çalışma Modu (lokal kullanım için dokunmayın) ──────────────────
# HOST=127.0.0.1          # varsayılan: sadece yerel erişim
# AUTH_ENABLED=false      # lokal kullanımda kapalı kalır
# SECRET_KEY=...          # boş bırakın — uygulama otomatik üretir

# ── Kullanım Telemetrisi ───────────────────────────────────────────
# Analist adı normalde UI'dan girilir (Ayarlar → "Analist Adı Soyadı" → analist.json).
# Sink URL koda gömülü (skills/telemetri.py → VARSAYILAN_SINK_URL). Aşağıdakiler opsiyonel override:
# ANALYST_NAME=ugur       # analist.json yoksa atıf için (login > analist.json > bu > OS user).
# USAGE_SINK_URL=...      # Gömülü toplayıcı URL'yi override eder (Google Apps Script Web App).
# --- Aşağıdakiler YALNIZCA owner (sen) makinesinde ayarlanır ---
# OWNER_KONSOL=true       # Owner konsolu: "Kullanım Raporu" + "Yetki" ekranlarını AÇAR. Analist build'lerinde EKLENMEZ.
#                         # (Eski USAGE_DASHBOARD bayrağı ARTIK OKUNMAZ — kopyalanan owner .env'i ekranları açmasın diye.)
# YETKI_PANELI=true       # Yalnız "Yetki" ekranını ayrıca AÇAR (verilmezse OWNER_KONSOL'a düşer). Analistte EKLENMEZ.
#                         # → ekip bu ekranı göremez (AUTH'tan bağımsız gate).
# USAGE_SINK_KEY=...      # Uzaktan Çek için Apps Script okuma anahtarı (owner).

# ── v2 (test sürümü) — eski uygulama ile paralel çalışsın diye ayrı port ──
PORT=5003

# ── Otomatik güncelleme (v2 Faz 2.5) ──
# Açık (varsayılan): iş yokken origin/v2'den otomatik çeker + yeniden başlar.
# Kapatmak için: AUTO_UPDATE=false
# AUTO_UPDATE=true
# AUTO_UPDATE_INTERVAL=600   # saniye (kontrol aralığı)

# ── Zamanlanmış disk temizliği (v2 Faz 3) ──
# Açık (varsayılan): iş yokken eskimiş önbellek (.api_cache), döndürülmüş log, UAT raporu (.xlsx),
# canlı-uygulama gözlem dosyası ve eski oturum arşivini siler. Analiz çıktıları/girdiler ASLA silinmez.
# DISK_TEMIZLIK=true
# DISK_TEMIZLIK_ARALIK=86400   # saniye (varsayılan 24 saat; en az 3600)

# ── Jira Köprüsü — Jira'yı web-chat gibi kullan (polling + taslak/onay) ──
# Task YORUMUNA '/analyst_agent analiz' yazılır → app JQL taramasıyla bulur, analiz eder,
# sonucu Jira YORUMU olarak yazar. Inbound bağlantı/webhook/tünel GEREKMEZ (lokal + OAuth).
# Varsayılan KAPALI; yalnız owner açar. Yazma (task güncelle / yeni task) → taslak+onay (MVP-2).
# JIRA_KOPRU=true
# JIRA_KOPRU_PROJELER=MBSTRADE,MBSOPS   # taranan projeler (zorunlu; boşsa çalışmaz)
# JIRA_KOPRU_ARALIK=60                  # saniye (tarama aralığı; en az 20)
# JIRA_KOPRU_PENCERE_DK=120             # kaç dakikalık güncellemeye bakılır
# JIRA_KOPRU_KOMUT=/analyst_agent       # tetik komut prefiksi
# JIRA_KOPRU_YAZAR_ALLOWLIST=           # boş=herkes; displayName/accountId virgüllü liste

# ── Sahiplik (owner) — yalnız çok-kullanıcılı AUTH açık kurulumda gerekir ──
# ADMIN_USER=<owner_kullanici_adi>   # bu kişi 'owner', diğerleri 'analist'
# AUTH_ENABLED=true                  # login zorunlu kıl (paylaşımlı sunucu)

# ── Analiz modeli (CLI modu; API key GEREKMEZ, abonelik kapsamında) ──
# Arayüzden de seçilir (Ana Sayfa → AI/Kota). Fable gibi kredi-gerektiren modeller HARİÇ.
# Örnekler: claude-sonnet-5 (dengeli) · claude-opus-4-8 / claude-opus-5 (güçlü) · claude-haiku-4-5-20251001 (hızlı)
# CLAUDE_CLI_MODEL=claude-sonnet-5
